{
  "name": "@ardiprasetiyo/esthetica-ui",
  "version": "0.0.4",
  "description": "Minimalist UI component library",
  "keywords": [
    "esthetica-ui",
    "vue",
    "typescript",
    "design-system",
    "minimalist"
  ],
  "homepage": "https://github.com/maserde/esthetica-ui#readme",
  "bugs": {
    "url": "https://github.com/maserde/esthetica-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maserde/esthetica-ui.git"
  },
  "license": "ISC",
  "author": "Ardi Hari Prasetiyo",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esthetica-ui.js",
      "require": "./dist/esthetica-ui.umd.cjs"
    },
    "./style.css": "./dist/esthetica-ui.css"
  },
  "main": "./dist/esthetica-ui.umd.cjs",
  "module": "./dist/esthetica-ui.js",
  "types": "./dist/src/index.d.ts",
  "style": "./dist/esthetica-ui.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && npm publish --access public",
    "release:minor": "npm version minor && npm publish --access public",
    "release:major": "npm version major && npm publish --access public",
    "prepare": "husky"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@iconify-json/ri": "^1.2.10",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.2",
    "@unocss/preset-icons": "^66.7.0",
    "@unocss/preset-typography": "^66.7.0",
    "@unocss/preset-web-fonts": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-storybook": "^10.4.1",
    "eslint-plugin-vue": "~10.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "lint-staged": "^17.0.6",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "typescript": "~6.0.0",
    "unocss": "^66.7.0",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue": "^3.5.32",
    "vue-tsc": "^3.2.6"
  },
  "peerDependencies": {
    "vue": "^3.5.32"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "lint-staged": {
    "src/**/*.{vue,ts,js,css}": [
      "oxfmt",
      "oxlint --fix",
      "eslint --fix --cache"
    ]
  }
}
